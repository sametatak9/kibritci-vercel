{
  "name": "kibritci_erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/build-vercel-api.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:gemini": "tsx scratch/test_gemini.ts",
    "migrate:firestore:audit": "node scripts/migrate-firestore.mjs --audit-only",
    "migrate:firestore:dry-run": "node scripts/migrate-firestore.mjs --dry-run",
    "migrate:firestore": "node scripts/migrate-firestore.mjs --execute",
    "migrate:firestore:verify": "node scripts/migrate-firestore.mjs --verify-only",
    "migrate:ensure-config": "node scripts/ensure-target-config.mjs",
    "migrate:full": "node scripts/run-full-migration.mjs",
    "evrak:split-pdf": "node scripts/split-pdf-pages.mjs",
    "evrak:import-pdf:dry-run": "node scripts/import-legacy-evrak-pdf.mjs --dry-run",
    "evrak:import-pdf": "node scripts/import-legacy-evrak-pdf.mjs --execute",
    "backup:firestore": "node scripts/firestore-backup-local.mjs",
    "backup:verify": "node scripts/firestore-backup-verify.mjs",
    "backup:audit": "node scripts/migrate-firestore.mjs --audit-only",
    "restore:yoklama:dry-run": "node scripts/firestore-restore-selective.mjs --dry-run",
    "restore:yoklama": "node scripts/firestore-restore-selective.mjs --execute",
    "auth:sync-claims": "node scripts/sync-auth-claims.mjs",
    "birbesan:inspect": "node scripts/import-birbesan-stok-xlsx.mjs --dir data/birbesan --inspect",
    "birbesan:import:dry-run": "node scripts/import-birbesan-stok-xlsx.mjs --dir data/birbesan --dry-run",
    "birbesan:import": "node scripts/import-birbesan-stok-xlsx.mjs --dir data/birbesan --execute",
    "birbesan:seed:dry-run": "node scripts/seed-birbesan-stok-catalog.mjs --dry-run",
    "birbesan:seed": "node scripts/seed-birbesan-stok-catalog.mjs --execute",
    "birbesan:dedupe": "node scripts/seed-birbesan-stok-catalog.mjs --execute --dedupe-only",
    "birbesan:faturalar:dry-run": "node scripts/seed-birbesan-faturalar.mjs --dry-run",
    "birbesan:faturalar": "node scripts/seed-birbesan-faturalar.mjs --execute",
    "cron:akvizyon-nobet": "node scripts/cron-akvizyon-nobet.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
