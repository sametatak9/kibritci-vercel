# Firebase — kibritci-erp (canlı personel + yoklama). Boş bırakılırsa firebase-applet-config.json kullanılır.
# Vercel Dashboard > Project > Settings > Environment Variables

VITE_FIREBASE_PROJECT_ID=kibritci-erp
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kibritci-erp.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=kibritci-erp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# kibritci-erp için boş bırakın → (default)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

GEMINI_API_KEY=

# Firebase Admin — şifre sıfırlama, cron ve kurucu bootstrap
# Firebase Console > Project settings > Service accounts > Generate new private key
# JSON içeriğini tek satır olarak yapıştırın:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Vercel Cron (Akvizyon nöbet 21:00 İstanbul = 18:00 UTC)
CRON_SECRET=
